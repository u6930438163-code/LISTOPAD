[Unit]
Description=BastillaOS Connect outbound API diagnostics
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/bastilla-connect/config.env
User=nobody
Group=nogroup
ExecStart=/usr/bin/bastilla-connect check
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
