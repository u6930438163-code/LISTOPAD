{
  "name": "bastillaos",
  "description": "BastillaOS web interface, SVL kernel, AI agents and local/cloud model integrations.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "start": "node --import tsx server.ts",
    "maintenance": "node scripts/maintenance.mjs",
    "check:gemini": "node scripts/check-gemini.mjs",
    "check:api": "node scripts/check-bastilla-api.mjs",
    "setup:ollama": "bash scripts/setup-ollama.sh",
    "setup:codex": "bash scripts/setup-codex.sh",
    "codex": "bash scripts/run-codex.sh",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "build:server": "mkdir -p bastillaos/build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=bastillaos/build/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start:mcp": "bash scripts/start-bastilla-mcp.sh",
    "mcp:client": "python integrations/mcp/client.py"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "firebase": "^13.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
