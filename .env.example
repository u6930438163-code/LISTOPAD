# Model v2 only for chat; never fall back to cloud providers or local NLP.
# ── Czat Triady (Alex, Astyria, Aurelius): swobodna rozmowa ──────────────
# Silniki główne: serwer Ollama oraz wbudowane Gemini API (AI Studio).
LLM_PROVIDERS="ollama"
# Wymuś Gemini jako ostatnią opcję także jeśli stary .env ma gemini na początku.
# Ustaw "off", aby przywrócić ręczną kolejność LLM_PROVIDERS.
GEMINI_AS_FALLBACK="off"
# Awaryjny without_nlp po awarii modeli (domyślnie off = czat zwraca błąd).
CHAT_LOCAL_FALLBACK="off"
# Best-fit router: krótkie pytania o stan systemu dostają natychmiastową odpowiedź bez modelu ("off" wyłącza).
BEST_FIT_ROUTER="off"

# ── Google Gemini API (zautomatyzowane w AI Studio) ────────────────────────
# GEMINI_API_KEY: Wymagany do połączenia z Google Gemini.
# AI Studio automatycznie wstrzykuje ten klucz w czasie działania z sekretów użytkownika.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
# Modele zapasowe Gemini (po przecinku), używane przy limicie 429 / braku modelu.
GEMINI_FALLBACK_MODELS="gemini-3.7-flash"

# ── xAI (Grok) ──────────────────────────────────────────────────────────────
# https://console.x.ai/
XAI_API_KEY=""
XAI_MODEL=""
XAI_BASE_URL="https://api.x.ai/v1"

# ── Ollama (Lokalne LLM) ────────────────────────────────────────────────────
# Działa bez internetu i bez kluczy. Instalacja: npm run setup:ollama
OLLAMA_MODEL="huihui_ai/qwen3-abliterated:14b-v2"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_KEEP_ALIVE="24h"   # model zostaje w pamięci
OLLAMA_NUM_CTX="4096"     # okno kontekstu
OLLAMA_NUM_THREAD=""      # automatyczna liczba wątków CPU
OLLAMA_NUM_PREDICT="3072" # maks. długość odpowiedzi w tokenach
# Limit sekund na jednego dostawcę czatu; przy wielu agentach i Ollamie jest mnożony przez liczbę agentów.
LLM_TIMEOUT_SEC="360"

# ── OpenRouter API (HyperOS) ────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="minimax/minimax-m3.1-flash:free"

# ── Fallback NLP (Groq / OpenAI API) ────────────────────────────────────────
FALLBACK_NLP_BASE_URL="https://api.groq.com/openai/v1"
FALLBACK_NLP_API_KEY=""
FALLBACK_NLP_MODEL="openai/gpt-oss-120b"

# ── SearXNG: prawdziwe zdjęcia z internetu, osobno od generowania AI ────────
# Uruchom: integrations/searxng/docker-compose.yml (szczegóły w README).
# Serwer musi osiągać ten URL; w innej sieci/kontenerze localhost nie zadziała.
SEARXNG_BASE_URL="http://127.0.0.1:8080"

# ── Inne Zmienne Środowiskowe ───────────────────────────────────────────────
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"


# ── OpenAI & ChatGPT (opcjonalne, klucz API ze strony platform.openai.com) ──
# Działa jako dostawca w czacie agentów oraz do generowania obrazów.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_IMAGE_MODEL="gpt-image-1"

# Maximum incoming request body size in MiB (1-1024, default 1024).
# Base64 file attachments increase request size by about 33%.
BASTILLA_UPLOAD_MAX_MB=1024

# GPT Actions (REST, no MCP). Disabled until both values are set.
# Public HTTPS origin only, e.g. https://your-deployed-app.example
GPT_ACTIONS_PUBLIC_URL=""
# Set a fresh random secret (32+ characters) in deployment secrets, never in git.
GPT_ACTIONS_TOKEN=""

# --- Serwer MCP (/api/mcp) dla Claude / ChatGPT / Cursor ---
# MCP_AUTH_TOKEN: wymagany przy publicznym wdrożeniu (Cloud Run). Bez niego w produkcji MCP zwraca 503.
#   Claude Code:  claude mcp add --transport http bastilla https://<adres>/api/mcp --header "Authorization: Bearer <token>"
#   claude.ai:    Ustawienia -> Connectors -> Add custom connector -> https://<adres>/api/mcp/<token>
# Wygeneruj: openssl rand -hex 32
MCP_AUTH_TOKEN=""
# MCP_PATH_SECRET: opcjonalnie osobny sekret dla adresu /api/mcp/<sekret> (domyślnie = MCP_AUTH_TOKEN).
MCP_PATH_SECRET=""
